{
  "name": "mundus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-release-notices.mjs",
    "data:development": "node scripts/build-undp-development.mjs",
    "data:vector-globe": "node scripts/build-natural-earth-vector-globe.mjs",
    "data:label-anchors": "node --experimental-strip-types scripts/build-country-label-anchors.mjs",
    "data:label-slots": "node scripts/build-surname-label-slots.mjs",
    "data:surname-coverage": "node scripts/build-surname-coverage.mjs",
    "data:cities": "node scripts/build-geonames-major-cities.mjs",
    "data:cities:capture": "node scripts/build-geonames-major-cities.mjs --capture",
    "data:surnames": "node scripts/build-surname-observation.mjs",
    "toolchain:verify": "node scripts/verify-toolchain.mjs",
    "data:verify": "pnpm toolchain:verify && node scripts/verify-generated-data.mjs",
    "release:verify": "node scripts/verify-pages-artifact.mjs",
    "release:serve": "node scripts/serve-literal-mount.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:release": "node --test scripts/verify-pages-artifact.test.mjs",
    "test:release-server": "node --test scripts/serve-literal-mount.test.mjs",
    "test:data-cities": "node --test scripts/build-geonames-major-cities.test.mjs",
    "test:toolchain": "node --test scripts/verify-toolchain.test.mjs",
    "test:data-vector-globe": "node --test --test-name-pattern='production vector assets|handles antimeridian holes|meshopt encoding' scripts/build-natural-earth-vector-globe.test.mjs && node --test scripts/publish-asset-set.test.mjs",
    "test:data-vector-globe:full": "node --test scripts/build-natural-earth-vector-globe.test.mjs scripts/publish-asset-set.test.mjs",
    "test:performance": "node --test scripts/measure-publication-candidate.test.mjs",
    "measure:publication-candidate": "node scripts/measure-publication-candidate.mjs",
    "measure:publication-candidate:compare": "node scripts/measure-publication-candidate.mjs --compare",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-playwright-e2e.mjs --project=chromium --grep @smoke",
    "check:source": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm data:verify && pnpm test:data-cities && pnpm test:toolchain && pnpm test:performance && pnpm test && pnpm test:release",
    "check": "pnpm check:source && pnpm test:data-vector-globe && pnpm build && pnpm release:verify"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "d3-geo": "3.1.1",
    "meshoptimizer": "1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "opencc-js": "1.4.1",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
